{% extends 'base.html.twig' %}
{% form_theme form 'form/_planet_radio_theme.html.twig' %}

{% block title %}Log in!{% endblock %}

{% block body %}
<div class="w-full max-w-md p-8 bg-gray-800 rounded-2xl shadow-lg border border-gray-700">
    <h1 class="text-3xl text-center mb-6 text-blue-400">Créer un compte</h1>
    {{ form_start(form) }}
    {{ form_row(form.email) }}
    {{ form_row(form.password) }}

    <hr class="my-6 border-gray-600">

    <h2 class="text-xl mb-4 text-green-400">Créer votre commandant</h2>
    {{ form_row(form.originalPlayer.name) }}
    {{ form_row(form.originalPlayer.planets) }}

    <button class="mt-6 w-full bg-blue-600 hover:bg-blue-500 text-white py-2 rounded">S’inscrire</button>
    {{ form_end(form) }}
    </form>
</div>
{% endblock %}