<div
        {{ stimulus_controller('building', {
            'planet': planet.id,
            'building': building.id,
            'buildingCosts': building.prices
        }) }}
        class="bg-gray-900 text-white p-4 rounded-xl shadow-md space-y-4"
>
    <div class="flex items-center gap-4">
        <img src="{{ asset('uploads/images/building/' ~ building.image) }}" alt="{{ building.name }}"
             class="w-16 h-16 object-contain">
        <div>
            <h2 class="text-xl font-bold">{{ building.name }} (Niv. {{ building.level }})</h2>
            <p class="text-sm text-gray-400">{{ building.description }}</p>
        </div>
    </div>

    <div>
        <h3 class="font-semibold text-sm mb-2 text-gray-300">Temps de construction : {{ building.constructionTime }}</h3>
    </div>

    <div>
        <h3 class="font-semibold text-sm mb-2 text-gray-300">Coût pour niveau {{ building.level + 1 }} :</h3>
        <ul class="space-y-1">
            {% for price in building.prices %}
                <li class="flex items-center justify-between">
                    <span class="text-sm text-gray-300">{{ price.resourceName|capitalize }}</span>
                    <span class="text-sm font-mono" data-resource="{{ price.resourceName }}">{{ price.quantity|number_format(0, ',', ' ') }}</span>
                </li>
            {% endfor %}
        </ul>
    </div>

    <button
            {{ stimulus_target('building', 'buildButton') }}
            {{ stimulus_action('building', 'build', 'click') }}
            type="button"
            class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded disabled:opacity-50 disabled:cursor-not-allowed transition"
            disabled
    >
        Construire
    </button>
</div>
