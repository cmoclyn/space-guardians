<div {{ stimulus_controller('resource', {
    'quantity': resource.quantity,
    'production': resource.production,
    'maximum': resource.maximum,
    'name': resource.name,
    'date': resource.date.getTimestamp()
}) }}>
    <div class="flex items-center gap-2">
        <div {{ stimulus_controller('tooltip', {position: tooltipDirection}) }}>
        <span data-resource-target="quantity"
              data-action="mouseenter->tooltip#show mouseleave->tooltip#hide">{{ resource.quantity|number_format(0, '.', ' ') }}</span>

            <div data-tooltip-target="tooltip">
                +{{ resource.production|number_format(2) }}/h
            </div>
        </div>

        <div {{ stimulus_controller('tooltip', {position: tooltipDirection}) }}>
            <img src="{{ asset('uploads/images/resource/' ~ resource.image) }}"
                 alt="{{ resource.name }}"
                 data-action="mouseenter->tooltip#show mouseleave->tooltip#hide"
                 class="w-6 h-6"
            />

            <div data-tooltip-target="tooltip">
                {{ resource.name }}
            </div>
        </div>
    </div>
</div>