<div {{ stimulus_controller('resource') }}>
    {% set tooltipDirection = tooltipDirection|default('bottom') %}
    <div class="flex items-center gap-2">
        <div {{ stimulus_controller('tooltip', {position: tooltipDirection}) }}>
        <span {{ stimulus_target('resource', 'quantity') }} data-action="mouseenter->tooltip#show mouseleave->tooltip#hide"></span>
            <div {{ stimulus_target('resource', 'production') }} data-tooltip-target="tooltip"></div>
        </div>

        <div {{ stimulus_controller('tooltip', {position: tooltipDirection}) }}>
            <img {{ stimulus_target('resource', 'image') }}
                 data-action="mouseenter->tooltip#show mouseleave->tooltip#hide"
                 class="w-6 h-6"
            />

            <div {{ stimulus_target('resource', 'name') }} data-tooltip-target="tooltip"></div>
        </div>
    </div>
</div>