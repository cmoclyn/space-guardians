
{% if building is not empty %}
    <div {{ stimulus_controller('building-queue', {
    'startedAt': buildling.startedAt.getTimestamp(),
    'finishedAt': buildling.finishedAt.getTimestamp(),
}) }}>
        {{ building.name }} (<span {{ stimulus_target('building-queue', 'remainingTime') }}></span>)
    </div>
{% else %}
    <p class="text-gray-400 text-sm">Aucune construction en cours.</p>
{% endif %}